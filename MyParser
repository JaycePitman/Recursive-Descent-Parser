import java.io.File;
import java.io.FileReader;
import java.io.IOException;
import java.io.FileNotFoundException;
import java.util.Scanner;
import java.util.ArrayList;
import java.util.List;

public class App {
    public enum CharClass{
        UNDERSCORE, LETTER, DIGIT, UNKNOWN, ERROR,EOF
    }
    public enum Tokens{
        INT_LIT, IDENT, ASSIGN_OP, ADD_OP, SUB_OP, 
        MULT_OP, DIV_OP, LEFT_PAREN, RIGHT_PAREN, 
        EQUALS, NOT_EQUALS, GREATER_THAN, LESS_THAN, 
        FUN_CALL, INPUT, OUTPUT, IF, WHILE, TYPE,
        THEN, ELSE, END, LOOP, PROGRAM, BEGIN, 
        COMMA, COLON, DECIMAL, SEMI_COLON, 
        ERROR, EOF
    }
    
    public static List<String> identifiers = new ArrayList<>();
    public static List<Character> lexemeList = new ArrayList<>();

    public static CharClass charClass;
    public static String lexemeString;
    public static char nextChar;
    public static int lexLen;
    public static int token;
    public static Tokens nextToken;
    public static File file;
    public static FileReader reader;
    public static int lineCount = 1;
    public static boolean errorFound = false;

    public static void main(String[] args) throws Exception {
        try {
            identifiers.add("program");
            identifiers.add("begin");
            identifiers.add("end");
            identifiers.add("if");
            identifiers.add("then");
            identifiers.add("else");
            identifiers.add("input");
            identifiers.add("output");
            identifiers.add("int");
            identifiers.add("while");
            identifiers.add("loop");
            identifiers.add("call");
            identifiers.add("int");
            identifiers.add("float");
            identifiers.add("double");

            System.out.println("Enter file path: ");
            Scanner input = new Scanner(System.in);
            String filePath = input.nextLine();
            file = new File(filePath);
            input.close();
            reader = new FileReader(file);
            
            getChar();
            lex();
            PROGRAM();

            reader.close();
          } 
          catch (FileNotFoundException e) {
            System.out.println("Error! Could not open file.");
            e.printStackTrace();
          }
    }
    //returns true if errors were found
    public static boolean isThereErrors(){
        return errorFound;
    }
    //Used when errors are found to:
    //  - display error message 
    //  - set charClass and nextToken to ERROR status 
    //  - errorFound to true
    public static void foundError(String  s, int line){
        //format string "Error !! <error message> at line <lineCount>"
        System.out.printf("%s%d!\n", s, line);
        charClass = CharClass.ERROR;
        nextToken = Tokens.ERROR;
        errorFound = true;
    }
    //Matches tokens with the token type
    public static Tokens lookup(char ch){
        switch(ch){
            case'(':
                addChar();
                nextToken = Tokens.LEFT_PAREN;
                break;
            case')':
                addChar();
                nextToken = Tokens.RIGHT_PAREN;
                break;
            case'+':
                addChar();
                nextToken = Tokens.ADD_OP;
                break;
            case'-':
                addChar();
                nextToken = Tokens.SUB_OP;
                break;
            case'*':
                addChar();
                nextToken = Tokens.MULT_OP;
                break;
            case'/':
                addChar();
                nextToken = Tokens.DIV_OP;
                break;
            case'=':
                addChar();
                nextToken = Tokens.EQUALS;
                break;
            case'>':
                addChar();
                nextToken = Tokens.GREATER_THAN;
                break;
            case'<':
                addChar();
                nextToken = Tokens.LESS_THAN;
                break;
            case';':
                addChar();
                nextToken = Tokens.SEMI_COLON;
                break;
            case':':
                addChar();
                nextToken = Tokens.COLON;
                break;
            case',':
                addChar();
                nextToken = Tokens.COMMA;
                break;
            case '.':
                addChar();
                nextToken = Tokens.DECIMAL;
                break;
            default:
                addChar();
                nextToken = Tokens.EOF;
                break;
        }
        return nextToken;
    }

    public static void addChar(){
        lexemeList.add(lexLen++, nextChar);
        lexemeList.add(lexLen, '\0');
    }

    public static void getChar(){
        try{
            int unicodeChar = reader.read();
            if(unicodeChar != -1){
                nextChar = (char)unicodeChar;
            }
            else{
                nextChar = '\0';
                nextToken = Tokens.EOF;
            }
        }
        catch(IOException e){
            e.printStackTrace();
        }
        
        if(nextToken != Tokens.EOF){
            if(Character.isLetter(nextChar)){
                charClass = CharClass.LETTER;
            }
            else if(Character.isDigit(nextChar)){
                charClass = CharClass.DIGIT;
            }
            else if(nextChar == '_'){
                charClass = CharClass.UNDERSCORE;
            }
            else
                charClass = CharClass.UNKNOWN;
        }
        else
            charClass = CharClass.EOF;
    }

    public static void getNonBlank() {
        while (Character.isWhitespace(nextChar)) {
            if (nextChar == '\r') {
                getChar();
                if (nextChar == '\n') {
                    getChar(); // Windows-style \r\n
                }
                lineCount++;
            } 
            else if (nextChar == '\n') {
                lineCount++;
                getChar(); // Unix-style \n
            } 
            else {
                getChar(); // Regular whitespace
            }
        }
    }

    //converts the characters in lexemeList into a string
    public static String convertLexemeListToString(){
        StringBuilder sb = new StringBuilder();
        for (char c : lexemeList) {
                sb.append(c);
            }
        return lexemeString = sb.toString().trim();
    }

    public static Tokens lex(){
        lexLen = 0;
        //empty the lexemeList
        lexemeList.clear();
        getNonBlank();
        switch(charClass){
            /*parse identifiers */
            case LETTER:
            case UNDERSCORE:
                addChar();
                getChar();
                while(charClass == CharClass.LETTER || 
                      charClass == CharClass.DIGIT || 
                      charClass == CharClass.UNDERSCORE){
                    addChar();
                    getChar();
                }
                lexemeString = convertLexemeListToString();
                switch(lexemeString){
                    case "program":
                        nextToken = Tokens.PROGRAM;
                        break;
                    case "begin":
                        nextToken = Tokens.BEGIN;
                        break;
                    case "end":
                        nextToken = Tokens.END;
                        break;
                    case "if":
                        nextToken = Tokens.IF;
                        break;
                    case "then":
                        nextToken = Tokens.THEN;
                        break;
                    case "else":
                        nextToken = Tokens.ELSE;
                        break;
                    case "input":
                        nextToken = Tokens.INPUT;
                        break;
                    case "output":
                        nextToken = Tokens.OUTPUT;
                        break;
                    case "int":
                        nextToken = Tokens.TYPE;
                        break;
                    case "float":
                        nextToken = Tokens.TYPE;
                        break;
                    case "double":
                        nextToken = Tokens.TYPE;
                        break;
                    case "while":
                        nextToken = Tokens.WHILE;
                        break;
                    case "loop":
                        nextToken = Tokens.LOOP;
                        break;
                    case "call":
                        nextToken = Tokens.FUN_CALL;
                        break;
                    default:
                        nextToken = Tokens.IDENT;
                        break;
                }

                break;
            /*parse integer literals and floats and doubles */
            case DIGIT:
                addChar();
                getChar();
                int i = 0;
                while(charClass == CharClass.DIGIT && i < 11){
                    addChar();
                    getChar();
                    i++;
                }
                if(nextChar == '.'){
                    addChar();
                    getChar();
                    while (charClass == CharClass.DIGIT && i < 11) {
                        addChar();
                        getChar();
                        i++;
                    }
                }
                if(i>10){
                    foundError("Error !! Integer or floating point too long at line ", lineCount);
                }
                nextToken = Tokens.INT_LIT;
                break;
            /*parentheses and operators */
            case UNKNOWN:
                lookup(nextChar);
                if(nextToken == Tokens.LESS_THAN){
                    addChar();
                    getChar();
                    lookup(nextChar);
                    if(nextToken == Tokens.GREATER_THAN){
                        addChar();
                        getChar();
                        nextToken = Tokens.NOT_EQUALS;
                    }
                }
                else if(nextToken == Tokens.COLON){
                    getChar();
                    if(nextChar == '='){
                        lookup(nextChar);
                        if(nextToken == Tokens.EQUALS){
                            nextToken = Tokens.ASSIGN_OP;
                        }
                    }
                }
                getChar();
                break;
            /*EOF */
            case EOF:
                nextToken = Tokens.EOF;
                lexemeList.add(0, 'E');
                lexemeList.add(1, 'O');
                lexemeList.add(2, 'F');
                lexemeList.add(3, '\0');
                break;
            case ERROR:
                break;
        }
        lexemeString = convertLexemeListToString();
        //System.out.printf("Next token is: %s, Next lexeme is %s\n", nextToken, lexemeString);
        return nextToken;
    }
    //EXPR -> FACTOR | FACTOR (+|-) EXPR
     public static void EXPR(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("EXPR\n");
        FACTOR(); // parse first factor
        if(isThereErrors()){
            return;
        }
        if(nextToken == Tokens.ADD_OP || nextToken == Tokens.SUB_OP){
            lex(); 
            EXPR();
        } // get the next token and parse the next EXPR
    }
    //FACTOR -> OPERAND | OPERAND (*|/) FACTOR
    public static void FACTOR(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("FACTOR\n");
        OPERAND(); // parse the first operand
        if(isThereErrors()){
            return;
        }
        if(nextToken == Tokens.MULT_OP || nextToken == Tokens.DIV_OP){
            lex(); 
            FACTOR();
        } // get the next token and parse the next FACTOR
    }
    //OPERAND -> NUM|ID|( EXPR )|FUNCALL 
    public static void OPERAND(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("OPERAND\n");
        //Determine which RHS
        if((nextToken == Tokens.IDENT && identifiers.contains(lexemeString)) || nextToken == Tokens.INT_LIT){
            lex();
        }
        else if(nextToken == Tokens.IDENT && !identifiers.contains(lexemeString)){
          foundError("ERROR !! Cannot use identifier before it has been declared! Error at line ", lineCount);
        } 
        //function call
        else if (nextToken == Tokens.FUN_CALL){
            lex();
            FUN_CALL();
        }
        //( EXPR )
        else if (nextToken == Tokens.LEFT_PAREN){
            lex(); 
            EXPR(); 
            if(isThereErrors()){
                return;
            }
           if(nextToken == Tokens.RIGHT_PAREN){
                lex();
            }
           else{
                foundError("Error !! Missing right paranthesis at line ", lineCount);
            }
        }
        else {
            foundError("Error !! Unknown token! Needs to be either a number, identifier, ( expression ), or function call. Error at line ", lineCount);
        }
    }
    //ID_LIST -> ID | ID , ID_LIST
    public static void ID_LIST(boolean declaringIDs){
        if(isThereErrors()){
            return;
        }
        System.out.printf("ID_LIST\n");
        if(nextToken == Tokens.IDENT){
            //declaring an ID not yet declared
            if(declaringIDs && !identifiers.contains(lexemeString)){
                identifiers.add(lexemeString);
                lex();
            }
            //using an ID not yet declared
            else if(!declaringIDs && !identifiers.contains(lexemeString)){
                foundError("ERROR !! Identifier not declared at line ", lineCount);
            }
            //declaring an ID already declared
            else if(declaringIDs && identifiers.contains(lexemeString)){
                foundError("ERROR !! Identifier already declared! Cannot redeclare a variable! Error at line ", lineCount);
            }
            //using an ID that has been declared already
            else{
                lex();
            }
            //continue if there are more IDs AND no errors found
            if(nextToken == Tokens.COMMA && !(isThereErrors())){
                lex();
                ID_LIST(declaringIDs);
            }
        }
        else{
            foundError("Error !! Token is not an identifier at line ", lineCount);
        }
    }
    //FUNCALL -> call ID( ID_LIST )
    public static void FUN_CALL(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("FUNCALL\n");
        if(nextToken == Tokens.IDENT){
            lex();
            if(nextToken == Tokens.LEFT_PAREN){
                lex();
                ID_LIST(false);
                if(isThereErrors()){
                    return;
                }
                if(nextToken == Tokens.RIGHT_PAREN){
                    lex();
                }
                else{
                    foundError("Error !! Missing right parenthesis at line ", lineCount);
                }
            }
            else{
                foundError("Error !! Missing left parenthesis at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Token is not an identifier at line ", lineCount);
        }
    }
    //COMP -> ( OPERAND = OPERAND ) 
    //      | ( OPERAND <> OPERAND ) 
    //      | ( OPERAND (<|>) OPERAND )
    public static void COMP(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("COMP\n");
        if(nextToken == Tokens.LEFT_PAREN){
            lex();
            OPERAND();
            if(isThereErrors()){
                return;
            }
            if(nextToken == Tokens.EQUALS || 
                nextToken == Tokens.NOT_EQUALS ||
                nextToken == Tokens.GREATER_THAN||
                nextToken == Tokens.LESS_THAN){
                    lex();
                    OPERAND();
                    if(isThereErrors()){
                        return;
                    }
                    if(nextToken == Tokens.RIGHT_PAREN){
                        lex();
                    }
                    else{
                        foundError("Error !! Missing right parenthesis at line ", lineCount);
                    }
            }
            else{
                foundError("Error !! Missing operator ('=', '<>', '<', or '>') at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Missing left parenthesis at line ", lineCount);
        }
    }
    //DECL -> ID_LIST : TYPE ;
    public static void DECL(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("DECL\n");
        ID_LIST(true);
        if(isThereErrors()){
            return;
        }
        if(nextToken == Tokens.COLON){
            if(isThereErrors()){
                return;
            }
            lex(); //get next token
            if(nextToken == Tokens.TYPE){
                lex();
                if(isThereErrors()){
                    return;
                }
                if(nextToken == Tokens.SEMI_COLON){
                    lex();
                }
                else{
                    foundError("Error !! Missing semi-colon at line ", lineCount);
                }
            }
            else{
                foundError("Error !! Missing variable type at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Missing colon at line ", lineCount);
        }
    }
    //DECL_SEC -> DECL | DECL DECL_SEC
    public static void DECL_SEC(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("DECL_SEC\n");
        DECL();
        if(isThereErrors()){
            return;
        }
        if(nextToken == Tokens.IDENT){
            DECL_SEC();
        }
    }
    //ASSIGN -> ID := EXPR ;
    public static void ASSIGN(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("ASSIGN\n");
        if(!identifiers.contains(lexemeString)){
            foundError("ERROR !! Cannot use identifier before it has been declared! Error at line ", lineCount);
            return;
        }
        lex();
        if(nextToken == Tokens.ASSIGN_OP){
            lex();
            EXPR();
            if(isThereErrors()){
                return;
            }
            if(nextToken == Tokens.SEMI_COLON){
                return;
            }
            else{
                foundError("Error !! Missing semi-colon at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Missing assignment operator at line ", lineCount);
        }
    }
    //IFSTMT -> if COMP then STMT_SEC end if ; |
    //          if COMP then STMT_SEC else STMT_SEC end if ;
    public static void IF_STMT(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("IF_STMT\n");
        lex();
        COMP();
        if(isThereErrors()){
            return;
        }
        if(nextToken == Tokens.THEN){
            lex();
            while(nextToken != Tokens.ELSE && nextToken != Tokens.END){
                STMT_SEC();
                if(isThereErrors()){
                    return;
                }
            }
            if(nextToken == Tokens.ELSE){
                lex();
                STMT_SEC();
                if(isThereErrors()){
                    return;
                }
            }
            if(nextToken == Tokens.END){
                lex();
                if(nextToken == Tokens.IF){
                    lex();
                    if(nextToken == Tokens.SEMI_COLON){
                        return;
                    }
                    else{
                        foundError("Error !! Missing semi-colon at line ", lineCount);
                    }
                }
                else{
                    foundError("Error !! Missing 'if' token at line ", lineCount);
                }
            }
            else{
                foundError("Error !! Missing 'end' token at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Missing 'then' token at line ", lineCount);
        }
    }
    //WHILESTMT -> while COMP loop STMT_SEC end loop ;
    public static void WHILE_STMT(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("WHILE_STMT\n");
        lex();
        COMP();
        if(isThereErrors()){
            return;
        }
        if(nextToken == Tokens.LOOP){
            lex();
            STMT_SEC();
            if(isThereErrors()){
                return;
            }
            if(nextToken == Tokens.END){
                lex();
                if(nextToken == Tokens.LOOP){
                    lex();
                    if(nextToken == Tokens.SEMI_COLON){
                        return;
                    }
                    else{
                        foundError("Error !! Missing semi-colon at line ", lineCount);
                    }
                }
                else{
                    foundError("Error !! Missing 'loop' token at line ", lineCount);
                }
            }
            else{
                foundError("Error !! Missing 'end' token at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Missing 'loop' token at line ", lineCount);
        }
    }
    //INPUT -> input ID_LIST;
    public static void INPUT(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("INPUT\n");
        if(nextToken == Tokens.INPUT){
            lex();
            ID_LIST(false);
            if(isThereErrors()){
                return;
            }
            if(nextToken == Tokens.SEMI_COLON){
                return;
            }
            else{
                foundError("Error !! Missing semi-colon at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Missing 'input' token at line ", lineCount);
        }
    }
    //OUTPUT -> output ID_LIST; | output NUM;
    public static void OUTPUT(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("OUTPUT\n");
        if(nextToken == Tokens.OUTPUT){//can get rid off already checked
            lex();
            //could do switch stmt here
            if(nextToken == Tokens.IDENT){
                ID_LIST(false);
                if(isThereErrors()){
                    return;
                }
                if(nextToken == Tokens.SEMI_COLON){
                    return;
                }
                else{
                    foundError("Error !! Missing semi-colon at line ", lineCount);
                }
            }
            else if(nextToken == Tokens.INT_LIT){
                lex();
                if(isThereErrors()){
                    return;
                }
                if(nextToken == Tokens.SEMI_COLON){
                    return;
                }
                else{
                    foundError("Error !! Missing semi-colon at line ", lineCount);
                }
            }
            else{
                foundError("Error !! Missing either a list of identifiers or a number to output at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Missing 'output' token at line ", lineCount);
        }
    }
    //STMT -> ASSIGN | IFSTMT | WHILESTMT | INPUT | OUTPUT
    public static void STMT(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("STMT\n");
        switch (nextToken) {
            case IDENT:
                ASSIGN();
                break;
            case IF:
                IF_STMT();
                break;
            case WHILE:
                WHILE_STMT();
                break;
            case INPUT:
                INPUT();
                break;
            case OUTPUT:
                OUTPUT();
                break;
            default:
                foundError("Error !! Illegal start to a statement needs to be either an Assignment, If statment, While statement, input, or output ! Error at line ", lineCount);
        }
        if(isThereErrors()){
            return;
        }
        lex();
    }
    //STMT_SEC -> STMT | STMT STMT_SEC
    public static void STMT_SEC(){
        if(isThereErrors()){
            return;
        }
        System.out.printf("STMT_SEC\n");
        STMT();
        if(isThereErrors()){
            return;
        }
        if(nextToken != Tokens.END && nextToken != Tokens.ELSE){
            STMT_SEC();
        }
    }
    //PROGRAM -> program DECL_STMT begin STMT_SEC end; |
    //           program begin STMT_SEC end;        
    public static void PROGRAM(){
        System.out.printf("PROGRAM\n");
        if(nextToken == Tokens.PROGRAM){
            lex();
            if(nextToken == Tokens.IDENT){
                DECL_SEC();
                if(isThereErrors()){
                    return;
                }
            }
            if(nextToken == Tokens.BEGIN){
                lex();
                STMT_SEC();
                if(isThereErrors()){
                    return;
                }
                if(nextToken == Tokens.END){
                    lex();
                    if(nextToken == Tokens.SEMI_COLON){
                        lex();
                        if(nextToken == Tokens.EOF){
                            return;
                        }
                        else{
                            foundError("Error !! Cannot execute code after ending program! Error at line ", lineCount);
                        }
                    }
                    else{
                        foundError("Error !! Missing semi-colon at line ", lineCount);
                    }
                }
                else{
                    foundError("Error !! Missing 'end' token at line ", lineCount);
                }
            }
            else{
                foundError("Error !! Missing 'begin' token at line ", lineCount);
            }
        }
        else{
            foundError("Error !! Missing 'program' token at line ", lineCount);
        }
    }
}
